[Unit]
Description=UtopOS Agent — 诊断与管理系统
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/evo serve --bind 127.0.0.1:7890
Restart=on-failure
RestartSec=5
Environment=EVO_HOME=/var/lib/utopos
Environment=RUST_LOG=info
WorkingDirectory=/var/lib/utopos
StateDirectory=utopos
ConfigurationDirectory=utopos

# 安全加固
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/utopos /var/log/utopos
PrivateTmp=yes

[Install]
WantedBy=multi-user.target

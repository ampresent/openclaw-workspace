#!/usr/bin/env bash
# evo-monitor — 监控命令执行期间的文件变更
# 用法: evo-monitor <path> -- <command...>
#       evo-monitor <path> --name <label> -- <command...>
# 自动: snapshot_before → 执行命令 → snapshot_after → diff → 报告
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET=""
LABEL=""
CMD=()
REVERT_FILE=""
EXPECTED_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --name|-n)       LABEL="$2"; shift 2 ;;
    --revert|-r)     REVERT_FILE="$2"; shift 2 ;;
    --expected|-x)   EXPECTED_FILE="$2"; shift 2 ;;
    --help|-h)
      cat <<'HELP'
evo-monitor — 监控命令执行期间的文件变更

用法: evo-monitor <path> [选项] -- <command...>

选项:
  -n, --name <label>       监控标签
  -r, --revert <file>      生成回滚快照到此路径
  -x, --expected <file>    预期变更清单（JSONL），不在此清单的变更标记为异常
  -h, --help               显示帮助

工作流程:
  1. 对 <path> 拍摄 before 快照
  2. 执行 <command>
  3. 对 <path> 拍摄 after 快照
  4. 对比 before/after
  5. 如果有 --expected，交叉检查异常变更
  6. 输出报告

示例:
  evo-monitor /etc -- nginx -t
  evo-monitor /usr/lib --name nginx-upgrade -- yum install nginx
  evo-monitor /opt --expected allowlist.json -- pip install pkg
HELP
      exit 0
      ;;
    --)
      shift
      CMD=("$@")
      break
      ;;
    *)
      if [[ -z "$TARGET" ]]; then
        TARGET="$1"
      fi
      shift
      ;;
  esac
done

if [[ -z "$TARGET" ]]; then
  echo '{"status":"error","error":"用法: evo-monitor <path> -- <command>"}' >&2
  exit 1
fi

if [[ ${#CMD[@]} -eq 0 ]]; then
  echo '{"status":"error","error":"未指定要监控的命令"}' >&2
  exit 1
fi

[[ -z "$LABEL" ]] && LABEL="monitor-$(basename "$TARGET")"
TS=$(date +%Y%m%d-%H%M%S)
MONITOR_DIR="$EVO_HOME/snapshots"
REPORT_DIR="$EVO_HOME/reports"
mkdir -p "$MONITOR_DIR" "$REPORT_DIR"

# 1. before 快照
echo '{"status":"running","phase":"snapshot_before","target":"'"$TARGET"'"}' >&2
BEFORE_MANIFEST="$MONITOR_DIR/${LABEL}-before-${TS}.manifest"
"$SCRIPTS/evo-snapshot" "$TARGET" --output "$BEFORE_MANIFEST" --name "${LABEL}-before" >/dev/null

# 2. 执行命令
echo '{"status":"running","phase":"exec","cmd":'"$(printf '%s\n' "${CMD[@]}" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read().strip().split("\n")))')"'}' >&2
CMD_EXIT=0
CMD_OUTPUT_FILE=$(mktemp /tmp/evo-monitor-XXXXXX)
"${CMD[@]}" > "$CMD_OUTPUT_FILE" 2>&1 || CMD_EXIT=$?

# 3. after 快照
echo '{"status":"running","phase":"snapshot_after","target":"'"$TARGET"'"}' >&2
AFTER_MANIFEST="$MONITOR_DIR/${LABEL}-after-${TS}.manifest"
"$SCRIPTS/evo-snapshot" "$TARGET" --output "$AFTER_MANIFEST" --name "${LABEL}-after" >/dev/null

# 4. diff
echo '{"status":"running","phase":"diff"}' >&2
DIFF_OUTPUT=$("$SCRIPTS/evo-diff" "$BEFORE_MANIFEST" "$AFTER_MANIFEST" --json 2>/dev/null || echo '{"status":"error","action":"diff"}')

# 5. 检查异常变更（如果有 expected 清单）
UNEXPECTED_COUNT=0
UNEXPECTED_CHANGES="[]"
if [[ -n "$EXPECTED_FILE" && -f "$EXPECTED_FILE" ]]; then
  UNEXPECTED_CHANGES=$(python3 - "$DIFF_OUTPUT" "$EXPECTED_FILE" <<'PYEOF'
import json, sys
diff = json.loads(sys.argv[1])
expected_file = sys.argv[2]
expected_paths = set()
with open(expected_file) as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            obj = json.loads(line)
            if "path" in obj:
                expected_paths.add(obj["path"])
        except:
            if line:
                expected_paths.add(line)
unexpected = [c for c in diff.get("changes", []) if c.get("path") not in expected_paths]
print(json.dumps(unexpected, ensure_ascii=False))
PYEOF
  )
  UNEXPECTED_COUNT=$(echo "$UNEXPECTED_CHANGES" | python3 -c "import json,sys; print(len(json.loads(sys.stdin.read())))" 2>/dev/null || echo "0")
fi

# 6. 生成报告
REPORT_FILE="$REPORT_DIR/${LABEL}-${TS}.json"
DIFF_STATS=$(echo "$DIFF_OUTPUT" | python3 -c "import json,sys; d=json.load(sys.stdin); print(json.dumps(d.get('stats',{})))" 2>/dev/null || echo "{}")

cat > "$REPORT_FILE" <<EOF
{
  "ts": "$(date -Iseconds)",
  "label": "$LABEL",
  "target": "$(realpath "$TARGET")",
  "cmd": $(printf '%s\n' "${CMD[@]}" | python3 -c 'import json,sys; print(json.dumps(" ".join(sys.stdin.read().strip().split("\n"))))' 2>/dev/null || echo '""'),
  "cmd_exit": $CMD_EXIT,
  "before_manifest": "$BEFORE_MANIFEST",
  "after_manifest": "$AFTER_MANIFEST",
  "diff_stats": $DIFF_STATS,
  "unexpected_count": $UNEXPECTED_COUNT,
  "unexpected_changes": $UNEXPECTED_CHANGES,
  "verdict": $(if [[ "$UNEXPECTED_COUNT" -gt 0 ]]; then echo '"WARNING"'; elif [[ "$CMD_EXIT" -ne 0 ]]; then echo '"CMD_FAILED"'; else echo '"OK"'; fi)
}
EOF

# 输出到 stdout
echo "{\"status\":\"ok\",\"action\":\"monitor\",\"report\":\"$REPORT_FILE\",\"before\":\"$BEFORE_MANIFEST\",\"after\":\"$AFTER_MANIFEST\",\"cmd_exit\":$CMD_EXIT,\"unexpected\":$UNEXPECTED_COUNT,\"verdict\":$(if [[ "$UNEXPECTED_COUNT" -gt 0 ]]; then echo '"WARNING"'; elif [[ "$CMD_EXIT" -ne 0 ]]; then echo '"CMD_FAILED"'; else echo '"OK"'; fi)}"

# 清理
rm -f "$CMD_OUTPUT_FILE"

#!/usr/bin/env bash
# evo-get-info — 获取包的详细信息
# 用法: evo-get-info <pkg> [--backend nix|rpm|conda]
# 输出: JSON 包信息
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
PKG="${1:?用法: evo-get-info <pkg> [--backend nix|rpm|conda]}"
shift
BACKEND=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend) BACKEND="$2"; shift 2 ;;
    *) shift ;;
  esac
done

if [[ -z "$BACKEND" ]]; then
  BACKEND=$("$EVO_HOME"/scripts/evo-detect 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['backend'])" 2>/dev/null || echo "unknown")
fi

case "$BACKEND" in
  nix)
    VER=$(nix-instantiate --eval -E '(import <nixpkgs> {}).'$PKG'.version' 2>/dev/null | tr -d '"' || echo "unknown")
    DESC=$(nix-instantiate --eval -E '(import <nixpkgs> {}).'$PKG'.meta.description or "N/A"' 2>/dev/null | tr -d '"' || echo "N/A")
    HOMEPAGE=$(nix-instantiate --eval -E '(import <nixpkgs> {}).'$PKG'.meta.homepage or "N/A"' 2>/dev/null | tr -d '"' || echo "N/A")
    LICENSE=$(nix-instantiate --eval -E '(import <nixpkgs> {}).'$PKG'.meta.license.spdxId or "N/A"' 2>/dev/null | tr -d '"' || echo "N/A")
    STORE_PATH=$(nix-build '<nixpkgs>' -A "$PKG" --no-out-link 2>/dev/null || echo "N/A")
    SRC_DRV=$(nix-build '<nixpkgs>' -A "$PKG.src" --no-out-link 2>/dev/null || echo "N/A")
    echo '{"status":"ok","backend":"nix","pkg":"'"$PKG"'","version":"'"$VER"'","description":"'"$DESC"'","homepage":"'"$HOMEPAGE"'","license":"'"$LICENSE"'","store_path":"'"$STORE_PATH"'","src_derivation":"'"$SRC_DRV"'"}'
    ;;

  rpm)
    # 确保已安装或可用
    rpm -qi "$PKG" &>/dev/null || {
      # 尝试从 repo 获取
      if command -v dnf &>/dev/null; then
        INFO=$(dnf info "$PKG" 2>/dev/null | tail -20)
      else
        echo '{"status":"error","backend":"rpm","pkg":"'"$PKG"'","error":"package not installed and dnf/yum unavailable"}'
        exit 1
      fi
    }
    if rpm -qi "$PKG" &>/dev/null; then
      NAME=$(rpm -q --queryformat '%{NAME}' "$PKG" 2>/dev/null)
      VER=$(rpm -q --queryformat '%{VERSION}-%{RELEASE}' "$PKG" 2>/dev/null)
      ARCH=$(rpm -q --queryformat '%{ARCH}' "$PKG" 2>/dev/null)
      DESC=$(rpm -q --queryformat '%{SUMMARY}' "$PKG" 2>/dev/null)
      SIZE=$(rpm -q --queryformat '%{SIZE}' "$PKG" 2>/dev/null)
      VENDOR=$(rpm -q --queryformat '%{VENDOR}' "$PKG" 2>/dev/null)
      # 查找关联的 spec
      SPEC=$(find ~/rpmbuild/SPECS/ -name "*.spec" 2>/dev/null | head -1 || echo "N/A")
      echo '{"status":"ok","backend":"rpm","pkg":"'"$NAME"'","version":"'"$VER"'","arch":"'"$ARCH"'","description":"'"$(echo "$DESC" | sed 's/"/\\"/g')"'","size":"'"$SIZE"'","vendor":"'"$(echo "$VENDOR" | sed 's/"/\\"/g')"'","spec":"'"$SPEC"'"}'
    else
      echo '{"status":"error","backend":"rpm","pkg":"'"$PKG"'","error":"package not installed"}'
      exit 1
    fi
    ;;

  conda)
    INFO=$(conda list "$PKG" --json 2>/dev/null) || {
      echo '{"status":"error","backend":"conda","pkg":"'"$PKG"'","error":"conda list failed"}'
      exit 1
    }
    VER=$(echo "$INFO" | python3 -c "import sys,json; pkgs=json.load(sys.stdin); print(pkgs[0]['version'] if pkgs else 'not installed')" 2>/dev/null || echo "unknown")
    CHANNEL=$(echo "$INFO" | python3 -c "import sys,json; pkgs=json.load(sys.stdin); print(pkgs[0].get('channel','unknown') if pkgs else 'N/A')" 2>/dev/null || echo "unknown")
    BUILD=$(echo "$INFO" | python3 -c "import sys,json; pkgs=json.load(sys.stdin); print(pkgs[0].get('build','') if pkgs else '')" 2>/dev/null || echo "")
    echo '{"status":"ok","backend":"conda","pkg":"'"$PKG"'","version":"'"$VER"'","channel":"'"$CHANNEL"'","build":"'"$BUILD"'"}'
    ;;

  *)
    echo '{"status":"error","error":"unknown backend: '"$BACKEND"'"}'
    exit 1
    ;;
esac

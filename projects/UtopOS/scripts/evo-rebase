#!/usr/bin/env bash
# evo-rebase — 自动 rebase 本地 patch 到新上游版本
# 用法: evo-rebase <pkg> [--to <version>] [--auto-resolve]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
UPSTREAM_DIR="$EVO_HOME/upstream"
PATCHES_DIR="$EVO_HOME/patches"
PKG="${1:?用法: evo-rebase <pkg> [--to <version>] [--auto-resolve]}"
shift
TARGET_VERSION=""
AUTO_RESOLVE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)            TARGET_VERSION="$2"; shift 2 ;;
    --auto-resolve)  AUTO_RESOLVE=true; shift ;;
    *) shift ;;
  esac
done

UPSTREAM_FILE="$UPSTREAM_DIR/${PKG}.toml"
[[ -f "$UPSTREAM_FILE" ]] || { echo '{"status":"error","error":"upstream not registered for '"$PKG"'"}'; exit 1; }

LOCAL_UPSTREAM="$UPSTREAM_DIR/repos/$PKG"
[[ -d "$LOCAL_UPSTREAM/.git" ]] || { echo '{"status":"error","error":"local upstream repo not found, run evo-upstream-fetch first"}'; exit 1; }

PATCH_DIR="$PATCHES_DIR/$PKG"
SERIES_FILE="$PATCH_DIR/series"
[[ -f "$SERIES_FILE" ]] || { echo '{"status":"ok","message":"no patches to rebase","pkg":"'"$PKG"'","patches":0}'; exit 0; }

# 读取当前 patches 列表
PATCHES=()
while IFS= read -r line; do
  [[ -z "$line" || "$line" == \#* ]] && continue
  PATCHES+=("$line")
done < "$SERIES_FILE"

[[ ${#PATCHES[@]} -gt 0 ]] || { echo '{"status":"ok","message":"no patches to rebase","pkg":"'"$PKG"'","patches":0}'; exit 0; }

# 准备 rebase 工作目录
REBASE_DIR="/tmp/evo-rebase-${PKG}-$$"
mkdir -p "$REBASE_DIR"
trap 'rm -rf "$REBASE_DIR"' EXIT

cd "$LOCAL_UPSTREAM"

# 记录当前 HEAD
BASE_HEAD=$(git rev-parse HEAD 2>/dev/null)

# 如果指定了目标版本，切换到该版本
if [[ -n "$TARGET_VERSION" ]]; then
  git checkout "$TARGET_VERSION" --quiet 2>/dev/null || {
    echo '{"status":"error","error":"cannot checkout target version '"$TARGET_VERSION"'"}'
    exit 1
  }
else
  # 默认拉取最新
  BRANCH=$(grep '^branch ' "$UPSTREAM_FILE" | sed 's/branch = "\(.*\)"/\1/')
  git fetch origin "$BRANCH" --quiet 2>/dev/null || true
  git reset --hard "origin/$BRANCH" --quiet 2>/dev/null || true
fi

NEW_HEAD=$(git rev-parse HEAD 2>/dev/null)

# 逐个尝试 apply patches
cd "$REBASE_DIR"
cp -a "$LOCAL_UPSTREAM"/.git "$REBASE_DIR/" 2>/dev/null || true
git checkout "$NEW_HEAD" --quiet 2>/dev/null || true

APPLIED=() CONFLICTED=() SKIPPED=()
NEW_SERIES=()

for PATCH in "${PATCHES[@]}"; do
  PATCH_FILE="$PATCH_DIR/$PATCH"
  [[ -f "$PATCH_FILE" ]] || { SKIPPED+=("$PATCH:file-not-found"); continue; }

  if git apply --check "$PATCH_FILE" 2>/dev/null; then
    # 可以干净 apply
    git apply "$PATCH_FILE" 2>/dev/null
    git add -A 2>/dev/null || true
    git commit -q -m "rebase: $PATCH" --allow-empty 2>/dev/null || true
    APPLIED+=("$PATCH")
    NEW_SERIES+=("$PATCH")
  elif [[ "$AUTO_RESOLVE" == "true" ]]; then
    # 尝试 3-way merge
    if git apply --3way --check "$PATCH_FILE" 2>/dev/null; then
      git apply --3way "$PATCH_FILE" 2>/dev/null || true
      git add -A 2>/dev/null || true
      git commit -q -m "rebase (3way): $PATCH" --allow-empty 2>/dev/null || true
      APPLIED+=("$PATCH")
      NEW_SERIES+=("$PATCH")
    else
      # 完全冲突，无法自动解决
      git checkout -- . 2>/dev/null || true
      CONFLICTED+=("$PATCH")
    fi
  else
    CONFLICTED+=("$PATCH")
  fi
done

# 更新 series 文件（保留成功 apply 的 patch 顺序）
if [[ ${#APPLIED[@]} -gt 0 ]]; then
  {
    echo "# UtopOS patch series for $PKG"
    echo "# Rebased: $(date -Iseconds)"
    for p in "${NEW_SERIES[@]}"; do
      echo "$p"
    done
  } > "$SERIES_FILE"
fi

# 生成 rebase 报告
TIMESTAMP=$(date -Iseconds)
REPORT_FILE="$PATCH_DIR/.last-rebase.json"
cat > "$REPORT_FILE" <<EOF
{
  "pkg": "$PKG",
  "timestamp": "$TIMESTAMP",
  "base_head": "$BASE_HEAD",
  "new_head": "$NEW_HEAD",
  "total_patches": ${#PATCHES[@]},
  "applied": ${#APPLIED[@]},
  "conflicted": ${#CONFLICTED[@]},
  "skipped": ${#SKIPPED[@]},
  "applied_list": [$(printf '"%s",' "${APPLIED[@]}" 2>/dev/null | sed 's/,$//')],
  "conflicted_list": [$(printf '"%s",' "${CONFLICTED[@]}" 2>/dev/null | sed 's/,$//')],
  "skipped_list": [$(printf '"%s",' "${SKIPPED[@]}" 2>/dev/null | sed 's/,$//')]
}
EOF

# 输出结果
if [[ ${#CONFLICTED[@]} -eq 0 ]]; then
  echo '{"status":"ok","pkg":"'"$PKG"'","result":"clean","applied":'"${#APPLIED[@]}"',"conflicted":0,"skipped":'"${#SKIPPED[@]}"',"report":"'"$REPORT_FILE"'"}'
else
  echo '{"status":"conflict","pkg":"'"$PKG"'","result":"partial","applied":'"${#APPLIED[@]}"',"conflicted":'"${#CONFLICTED[@]}"',"skipped":'"${#SKIPPED[@]}"',"conflicted_patches":'"$(printf '["%s",' "${CONFLICTED[@]}" | sed 's/,$//' | sed 's/$/]/')"',"report":"'"$REPORT_FILE"'","message":"some patches have conflicts, resolve manually or use --auto-resolve"}'
  exit 2
fi

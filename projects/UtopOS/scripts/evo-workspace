#!/usr/bin/env bash
# evo-workspace — 工作目录生命周期管理
# 用法:
#   evo-workspace create <pkg>     — 创建工作目录
#   evo-workspace list             — 列出活跃工作目录
#   evo-workspace archive <pkg>    — 打包归档
#   evo-workspace status <pkg>     — 显示工作目录状态
#   evo-workspace cleanup <pkg>    — 删除工作目录
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
ACTION="${1:?用法: evo-workspace <create|list|archive|status|cleanup> [pkg]}"
shift

ws_create() {
  local PKG="${1:?evo-workspace create <pkg>}"
  local WORK_DIR="/tmp/evo-fix-${PKG}"
  local EVO_WORK="$EVO_HOME/work/$PKG"
  mkdir -p "$WORK_DIR" "$EVO_WORK"
  # 创建基本结构
  mkdir -p "$WORK_DIR/src" "$WORK_DIR/patches"
  # 元数据
  cat > "$WORK_DIR/.evo-meta.json" <<EOF
{"pkg":"$PKG","created":"$(date -Iseconds)","status":"active","patches":[]}
EOF
  echo '{"status":"ok","action":"create","pkg":"'"$PKG"'","work_dir":"'"$WORK_DIR"'","evo_work":"'"$EVO_WORK"'"}'
}

ws_list() {
  echo -n '{"status":"ok","action":"list","workspaces":['
  FIRST=true
  for dir in /tmp/evo-fix-*; do
    [[ -d "$dir" ]] || continue
    PKG="${dir#/tmp/evo-fix-}"
    META="$dir/.evo-meta.json"
    CREATED="unknown"
    STATUS="active"
    PATCH_COUNT=0
    if [[ -f "$META" ]]; then
      CREATED=$(python3 -c "import json; print(json.load(open('$META')).get('created','unknown'))" 2>/dev/null || echo "unknown")
      STATUS=$(python3 -c "import json; print(json.load(open('$META')).get('status','active'))" 2>/dev/null || echo "active")
    fi
    PATCH_COUNT=$(find "$dir/patches" -name '*.patch' 2>/dev/null | wc -l)
    SIZE=$(du -sh "$dir" 2>/dev/null | awk '{print $1}')
    [[ "$FIRST" == "true" ]] && FIRST=false || echo -n ','
    echo -n '{"pkg":"'"$PKG"'","dir":"'"$dir"'","status":"'"$STATUS"'","created":"'"$CREATED"'","patches":'"$PATCH_COUNT"',"size":"'"$SIZE"'"}'
  done
  echo ']}'
}

ws_archive() {
  local PKG="${1:?evo-workspace archive <pkg>}"
  local WORK_DIR="/tmp/evo-fix-${PKG}"
  [[ -d "$WORK_DIR" ]] || { echo '{"status":"error","action":"archive","pkg":"'"$PKG"'","error":"workspace not found"}'; exit 1; }
  local ARCHIVE="$EVO_HOME/archive/${PKG}-$(date +%Y%m%d-%H%M%S).tar.gz"
  mkdir -p "$EVO_HOME/archive"
  tar czf "$ARCHIVE" -C /tmp "evo-fix-${PKG}"
  # 标记已归档
  if [[ -f "$WORK_DIR/.evo-meta.json" ]]; then
    python3 -c "
import json
m = json.load(open('$WORK_DIR/.evo-meta.json'))
m['status'] = 'archived'
m['archive'] = '$ARCHIVE'
json.dump(m, open('$WORK_DIR/.evo-meta.json','w'), indent=2)
" 2>/dev/null || true
  fi
  echo '{"status":"ok","action":"archive","pkg":"'"$PKG"'","archive":"'"$ARCHIVE"'"}'
}

ws_status() {
  local PKG="${1:?evo-workspace status <pkg>}"
  local WORK_DIR="/tmp/evo-fix-${PKG}"
  [[ -d "$WORK_DIR" ]] || { echo '{"status":"error","action":"status","pkg":"'"$PKG"'","error":"workspace not found"}'; exit 1; }
  local META="$WORK_DIR/.evo-meta.json"
  local CREATED="unknown" STATUS="active"
  if [[ -f "$META" ]]; then
    CREATED=$(python3 -c "import json; print(json.load(open('$META')).get('created','unknown'))" 2>/dev/null || echo "unknown")
    STATUS=$(python3 -c "import json; print(json.load(open('$META')).get('status','active'))" 2>/dev/null || echo "active")
  fi
  local PATCHES=$(find "$WORK_DIR/patches" -name '*.patch' -printf '%f\n' 2>/dev/null | paste -sd, || echo "")
  local PATCH_COUNT=$(find "$WORK_DIR/patches" -name '*.patch' 2>/dev/null | wc -l)
  local SIZE=$(du -sh "$WORK_DIR" 2>/dev/null | awk '{print $1}')
  local SRC_SIZE="N/A"
  [[ -d "$WORK_DIR/src" ]] && SRC_SIZE=$(du -sh "$WORK_DIR/src" 2>/dev/null | awk '{print $1}')
  local LAST_BUILD="N/A"
  [[ -f "$WORK_DIR/.last-build" ]] && LAST_BUILD=$(cat "$WORK_DIR/.last-build")
  echo '{"status":"ok","action":"status","pkg":"'"$PKG"'","dir":"'"$WORK_DIR"'","workspace_status":"'"$STATUS"'","created":"'"$CREATED"'","patches":'"$PATCH_COUNT"',"patch_list":"'"$PATCHES"'","size":"'"$SIZE"'","src_size":"'"$SRC_SIZE"'","last_build":"'"$LAST_BUILD"'"}'
}

ws_cleanup() {
  local PKG="${1:?evo-workspace cleanup <pkg>}"
  local WORK_DIR="/tmp/evo-fix-${PKG}"
  [[ -d "$WORK_DIR" ]] || { echo '{"status":"error","action":"cleanup","pkg":"'"$PKG"'","error":"workspace not found"}'; exit 1; }
  rm -rf "$WORK_DIR"
  echo '{"status":"ok","action":"cleanup","pkg":"'"$PKG"'","removed":"'"$WORK_DIR"'"}'
}

case "$ACTION" in
  create)  ws_create "$@" ;;
  list)    ws_list ;;
  archive) ws_archive "$@" ;;
  status)  ws_status "$@" ;;
  cleanup) ws_cleanup "$@" ;;
  *)       echo '{"status":"error","error":"unknown action: '"$ACTION"' (valid: create|list|archive|status|cleanup)"}'; exit 1 ;;
esac

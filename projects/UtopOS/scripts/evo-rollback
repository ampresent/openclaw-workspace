#!/usr/bin/env bash
# evo-rollback — 多层回滚：包管理器 / btrfs + 文件系统
# 用法: evo-rollback <pkg> [--backend rpm|conda|btrfs] [--to <id>] [--revert] [--plan] [--dry-run]
#
# 第一层: 包管理器回滚 (yum history undo / conda --revision / btrfs snapshot rollback)
# 第二层: 文件系统回滚 (基于快照对比，恢复包管理器未覆盖的变更)
#
# 注: nix 自带 generation 回滚 (nixos-rebuild --rollback)，无需额外封装。
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
SCRIPTS="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PKG="${1:?用法: evo-rollback <pkg> [--backend nix|rpm|conda] [--to <id>] [--revert] [--plan] [--dry-run]}"
shift
BACKEND=""
TARGET=""
DO_REVERT=false
PLAN_ONLY=false
DRY_RUN=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend)   BACKEND="$2"; shift 2 ;;
    --to)        TARGET="$2"; shift 2 ;;
    --revert)    DO_REVERT=true; shift ;;
    --plan|-p)   PLAN_ONLY=true; shift ;;
    --dry-run|-n) DRY_RUN=true; shift ;;
    *) shift ;;
  esac
done

if [[ -z "$BACKEND" ]]; then
  BACKEND=$("$EVO_HOME"/scripts/evo-detect 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['backend'])" 2>/dev/null || echo "unknown")
fi

LOG_DIR="$EVO_HOME/logs"
mkdir -p "$LOG_DIR"
LOG_FILE="$LOG_DIR/${PKG}-rollback-$(date +%Y%m%d-%H%M%S).log"
REPORT_DIR="$EVO_HOME/reports"
mkdir -p "$REPORT_DIR"

# ── 查找最近的安装快照 ──
find_install_snapshot() {
  local phase="$1"  # pre-install / post-install
  # 从最近的安装报告中读取快照路径
  local REPORT
  REPORT=$(ls -t "$REPORT_DIR"/"${PKG}"-install-*.json 2>/dev/null | head -1)
  if [[ -f "$REPORT" ]]; then
    if [[ "$phase" == "before" ]]; then
      python3 -c "import json; print(json.load(open('$REPORT')).get('before',''))" 2>/dev/null
    else
      python3 -c "import json; print(json.load(open('$REPORT')).get('after',''))" 2>/dev/null
    fi
    return
  fi
  # 降级: 从 snapshots 目录找
  ls -t "$EVO_HOME/snapshots"/"${PKG}"-"${phase}"-*.manifest 2>/dev/null | head -1
}

# ── 记录回滚事务 ──
record_rollback() {
  local txn_id="$1" layer="$2"
  mkdir -p "$EVO_HOME/history"
  echo '{"ts":"'"$(date -Iseconds)"'","pkg":"'"$PKG"'","backend":"'"$BACKEND"'","action":"rollback","layer":"'"$layer"'","txn_id":"'"$txn_id"'"}' >> "$EVO_HOME/history/${PKG}.jsonl"
}

# ── PLAN: 预览模式 ──
if [[ "$PLAN_ONLY" == "true" ]]; then
  echo '{"status":"planning","pkg":"'"$PKG"'","backend":"'"$BACKEND"'"}' >&2

  BEFORE=$(find_install_snapshot "before")
  AFTER=$(find_install_snapshot "after")

  PLAN_LAYER1="{}"
  PLAN_LAYER2="{}"

  # 第一层: 包管理器回滚计划
  case "$BACKEND" in
    rpm)
      if [[ -n "$TARGET" ]]; then
        PLAN_LAYER1='{"layer":"package_manager","backend":"rpm","action":"yum history undo '"$TARGET"'"}'
      else
        TXN=$(yum history list "$PKG" 2>/dev/null | grep -v "^$" | head -3 | tail -1 | awk '{print $1}' || echo "")
        PLAN_LAYER1='{"layer":"package_manager","backend":"rpm","action":"yum history undo '"${TXN:-unknown}"'","txn_id":"'"${TXN:-unknown}"'"}'
      fi
      ;;
    conda)
      REV=$(conda list --revisions 2>/dev/null | tail -2 | head -1 | awk '{print $2}' || echo "")
      PLAN_LAYER1='{"layer":"package_manager","backend":"conda","action":"conda install --revision '"${REV:-unknown}"'","revision":"'"${REV:-unknown}"'"}'
      ;;
    btrfs)
      SNAP_DIR="${BTRFS_SNAP_DIR:-$EVO_HOME/btrfs-snapshots}"
      if [[ -n "$TARGET" ]]; then
        PLAN_LAYER1='{"layer":"btrfs","backend":"btrfs","action":"btrfs subvolume snapshot '"$TARGET"' → active","target_snapshot":"'"$TARGET"'"}'
      else
        LATEST_SNAP=$(ls -dt "$SNAP_DIR"/pre-install-* 2>/dev/null | head -1 || echo "")
        PLAN_LAYER1='{"layer":"btrfs","backend":"btrfs","action":"btrfs subvolume snapshot → latest pre-install","latest_snapshot":"'"${LATEST_SNAP:-none}"'"}'
      fi
      ;;
  esac

  # 第二层: 文件系统变更预览
  if [[ -n "$BEFORE" && -n "$AFTER" && -f "$BEFORE" && -f "$AFTER" ]]; then
    PLAN_LAYER2=$("$SCRIPTS/evo-diff" "$BEFORE" "$AFTER" --json 2>/dev/null || echo '{"total_changes":0}')
  else
    PLAN_LAYER2='{"layer":"filesystem","status":"no_snapshot","message":"无安装快照，无法预览文件系统回滚"}'
  fi

  echo "{\"status\":\"ok\",\"action\":\"plan\",\"pkg\":\"$PKG\",\"backend\":\"$BACKEND\",\"layer1\":$PLAN_LAYER1,\"layer2\":$PLAN_LAYER2,\"snapshots\":{\"before\":\"${BEFORE:-}\",\"after\":\"${AFTER:-}\"}}"
  exit 0
fi

# ══════════════════════════════════════
# 第一层: 包管理器回滚
# ══════════════════════════════════════
echo '{"status":"running","layer":1,"action":"package_manager_rollback","backend":"'"$BACKEND"'"}' >&2

LAYER1_STATUS="ok"
LAYER1_TXN=""

BTRFS_SNAP_DIR="${BTRFS_SNAP_DIR:-$EVO_HOME/btrfs-snapshots}"

case "$BACKEND" in
  rpm)
    if [[ -n "$TARGET" ]]; then
      CMD="yum history undo $TARGET"
    else
      TXN=$(yum history list "$PKG" 2>/dev/null | grep -v "^$" | head -3 | tail -1 | awk '{print $1}' || echo "")
      if [[ -z "$TXN" ]]; then
        echo '{"status":"error","layer":1,"backend":"rpm","error":"no transaction history found"}' >&2
        LAYER1_STATUS="error"
        CMD=""
      else
        CMD="yum history undo $TXN"
      fi
    fi
    if [[ -n "$CMD" ]]; then
      echo '{"status":"rolling_back","layer":1,"backend":"rpm","cmd":"'"$CMD"'"}' >&2
      if [[ "$DRY_RUN" == "true" ]]; then
        echo '{"status":"dry_run","layer":1,"cmd":"'"$CMD"'"}'
      elif $CMD 2>&1 | tee "$LOG_FILE"; then
        LAYER1_TXN="${TARGET:-auto}"
        record_rollback "$LAYER1_TXN" "package_manager"
      else
        LAYER1_STATUS="error"
      fi
    fi
    ;;

  conda)
    if [[ -n "$TARGET" ]]; then
      CMD="conda install --revision $TARGET"
    else
      REV=$(conda list --revisions 2>/dev/null | tail -2 | head -1 | awk '{print $2}' || echo "")
      if [[ -z "$REV" ]]; then
        echo '{"status":"error","layer":1,"backend":"conda","error":"no revision history found"}' >&2
        LAYER1_STATUS="error"
        CMD=""
      else
        CMD="conda install --revision $REV"
      fi
    fi
    if [[ -n "$CMD" ]]; then
      echo '{"status":"rolling_back","layer":1,"backend":"conda","cmd":"'"$CMD"'"}' >&2
      if [[ "$DRY_RUN" == "true" ]]; then
        echo '{"status":"dry_run","layer":1,"cmd":"'"$CMD"'"}'
      elif $CMD 2>&1 | tee "$LOG_FILE"; then
        LAYER1_TXN="${TARGET:-auto}"
        record_rollback "$LAYER1_TXN" "package_manager"
      else
        LAYER1_STATUS="error"
      fi
    fi
    ;;

  btrfs)
    # ── btrfs 快照回滚 ──
    # 原理: btrfs subvolume snapshot 生成原子级子卷快照，
    #       回滚 = 删除当前子卷 + 从快照创建新的可写子卷快照。
    # 优势: COW 写时复制，快照几乎零开销，回滚是原子操作。
    #
    # 要求:
    #   - 目标路径位于 btrfs 文件系统上
    #   - btrfs-progs 已安装 (btrfs subvolume show/snapshot/delete)
    #   - 安装前已通过 btrfs snapshot 创建 pre-install 快照

    BTRFS_MNT="${BTRFS_MNT:-/}"  # btrfs 挂载点，默认根分区
    SNAP_DIR="${BTRFS_SNAP_DIR:-$EVO_HOME/btrfs-snapshots}"
    mkdir -p "$SNAP_DIR"

    # 验证目标路径在 btrfs 上
    FSTYPE=$(stat -f -c '%T' "$BTRFS_MNT" 2>/dev/null || echo "unknown")
    if [[ "$FSTYPE" != "btrfs" ]]; then
      echo '{"status":"error","layer":1,"backend":"btrfs","error":"挂载点 '"$BTRFS_MNT"' 不是 btrfs 文件系统 (实际: '"$FSTYPE"')"}' >&2
      LAYER1_STATUS="error"
    else
      # 查找回滚目标快照
      if [[ -n "$TARGET" ]]; then
        # --to 指定快照路径
        SNAP_PATH="$TARGET"
      else
        # 自动找最近的 pre-install 快照
        SNAP_PATH=$(ls -dt "$SNAP_DIR"/pre-install-* 2>/dev/null | head -1 || echo "")
      fi

      if [[ -z "$SNAP_PATH" || ! -d "$SNAP_PATH" ]]; then
        echo '{"status":"error","layer":1,"backend":"btrfs","error":"找不到 btrfs pre-install 快照 '"${SNAP_PATH:-}"'"}' >&2
        LAYER1_STATUS="error"
      else
        # 先确认是有效的 btrfs 子卷
        if ! btrfs subvolume show "$SNAP_PATH" &>/dev/null; then
          echo '{"status":"error","layer":1,"backend":"btrfs","error":"不是有效的 btrfs 子卷: '"$SNAP_PATH"'"}' >&2
          LAYER1_STATUS="error"
        else
          # 回滚流程:
          # 1. 对当前子卷拍一个 rollback-from 快照 (作为保险)
          # 2. 删除当前活跃子卷内容
          # 3. 从 pre-install 快照创建新的可写快照替换

          ROLLBACK_FROM="$SNAP_DIR/rollback-from-$(date +%Y%m%d-%H%M%S)"

          echo '{"status":"rolling_back","layer":1,"backend":"btrfs","snapshot":"'"$SNAP_PATH"'","backup":"'"$ROLLBACK_FROM"'"}' >&2

          if [[ "$DRY_RUN" == "true" ]]; then
            echo '{"status":"dry_run","layer":1,"backend":"btrfs","action":"snapshot_restore","from":"'"$SNAP_PATH"'","backup":"'"$ROLLBACK_FROM"'"}'
            LAYER1_TXN="dry-run"
          else
            # Step 1: 保险快照（只读）
            if btrfs subvolume snapshot -r "$BTRFS_MNT" "$ROLLBACK_FROM" 2>&1 | tee "$LOG_FILE"; then
              echo '{"status":"ok","layer":1,"phase":"backup_snapshot","path":"'"$ROLLBACK_FROM"'"}' >&2
            else
              echo '{"status":"error","layer":1,"backend":"btrfs","error":"创建保险快照失败"}' >&2
              LAYER1_STATUS="error"
            fi

            if [[ "$LAYER1_STATUS" == "ok" ]]; then
              # Step 2: 从目标快照创建可写快照替换当前状态
              RESTORE_SNAP="$SNAP_DIR/restore-$(date +%Y%m%d-%H%M%S)"
              if btrfs subvolume snapshot "$SNAP_PATH" "$RESTORE_SNAP" 2>&1 | tee -a "$LOG_FILE"; then
                LAYER1_TXN=$(basename "$SNAP_PATH")
                record_rollback "$LAYER1_TXN" "btrfs"
                echo '{"status":"ok","layer":1,"backend":"btrfs","restored_from":"'"$SNAP_PATH"'","restored_to":"'"$RESTORE_SNAP"'"}'
              else
                echo '{"status":"error","layer":1,"backend":"btrfs","error":"从快照恢复失败"}' >&2
                LAYER1_STATUS="error"
              fi
            fi
          fi
        fi
      fi
    fi
    ;;

  *)
    echo '{"status":"error","layer":1,"error":"unknown backend: '"$BACKEND"'"}' >&2
    LAYER1_STATUS="error"
    ;;
esac

# ══════════════════════════════════════
# 第二层: 文件系统回滚
# ══════════════════════════════════════
LAYER2_STATUS="skipped"
LAYER2_RESULT="{}"

if [[ "$DO_REVERT" == "true" || "$LAYER1_STATUS" == "ok" ]]; then
  BEFORE=$(find_install_snapshot "before")
  AFTER=$(find_install_snapshot "after")

  if [[ -n "$BEFORE" && -f "$BEFORE" ]]; then
    echo '{"status":"running","layer":2,"action":"filesystem_revert","before":"'"$BEFORE"'","after":"'"${AFTER:-auto}"'"}' >&2

    REVERT_ARGS=( "$EVO_HOME" --from "$BEFORE" )
    [[ -n "$AFTER" && -f "$AFTER" ]] && REVERT_ARGS+=( --to "$AFTER" )
    [[ "$DRY_RUN" == "true" ]] && REVERT_ARGS+=( --dry-run )

    LAYER2_RESULT=$("$SCRIPTS/evo-revert" "$EVO_HOME" --from "$BEFORE" ${AFTER:+--to "$AFTER"} ${DRY_RUN:+--dry-run} 2>/dev/null || echo '{"status":"error","layer":2}')
    LAYER2_STATUS="ok"

    # 记录
    if [[ "$DRY_RUN" != "true" ]]; then
      REVERTED=$(echo "$LAYER2_RESULT" | python3 -c "import json,sys; print(json.load(sys.stdin).get('reverted',0))" 2>/dev/null || echo "0")
      record_rollback "revert-$REVERTED" "filesystem"
    fi
  else
    LAYER2_STATUS="no_snapshot"
    echo '{"status":"skipped","layer":2,"reason":"no_install_snapshot"}' >&2
  fi
fi

# ══════════════════════════════════════
# 汇总报告
# ══════════════════════════════════════
ROLLBACK_REPORT="$REPORT_DIR/${PKG}-rollback-$(date +%Y%m%d-%H%M%S).json"
cat > "$ROLLBACK_REPORT" <<EOF
{
  "ts": "$(date -Iseconds)",
  "pkg": "$PKG",
  "backend": "$BACKEND",
  "layer1": {
    "type": "package_manager",
    "status": "$LAYER1_STATUS",
    "txn_id": "$LAYER1_TXN",
    "log": "$LOG_FILE"
  },
  "layer2": {
    "type": "filesystem",
    "status": "$LAYER2_STATUS",
    "result": $LAYER2_RESULT
  },
  "verdict": $(if [[ "$LAYER1_STATUS" == "error" ]]; then echo '"FAILED"'; elif [[ "$LAYER2_STATUS" == "no_snapshot" ]]; then echo '"PARTIAL"'; else echo '"OK"'; fi)
}
EOF

echo "{\"status\":\"ok\",\"action\":\"rollback\",\"pkg\":\"$PKG\",\"backend\":\"$BACKEND\",\"layer1\":\"$LAYER1_STATUS\",\"layer2\":\"$LAYER2_STATUS\",\"report\":\"$ROLLBACK_REPORT\"}"

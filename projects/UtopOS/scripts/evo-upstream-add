#!/usr/bin/env bash
# evo-upstream-add — 注册上游仓库
# 用法: evo-upstream-add <pkg> --url <repo-url> [--branch main] [--type community|internal]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
PKG="${1:?用法: evo-upstream-add <pkg> --url <repo-url> [--branch main] [--type community|internal]}"
shift
URL=""
BRANCH="main"
TYPE="community"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --url)    URL="$2"; shift 2 ;;
    --branch) BRANCH="$2"; shift 2 ;;
    --type)   TYPE="$2"; shift 2 ;;
    *) shift ;;
  esac
done

[[ -n "$URL" ]] || { echo '{"status":"error","error":"--url is required"}'; exit 1; }

UPSTREAM_DIR="$EVO_HOME/upstream"
mkdir -p "$UPSTREAM_DIR"

UPSTREAM_FILE="$UPSTREAM_DIR/${PKG}.toml"
TIMESTAMP=$(date -Iseconds)

# 如果已存在，备份旧版本
if [[ -f "$UPSTREAM_FILE" ]]; then
  cp "$UPSTREAM_FILE" "${UPSTREAM_FILE}.bak"
  echo '{"status":"updated","pkg":"'"$PKG"'","previous":"'"${UPSTREAM_FILE}.bak"'"}' >&2
fi

cat > "$UPSTREAM_FILE" <<EOF
# UtopOS upstream config for $PKG
# Updated: $TIMESTAMP

[pkg]
name = "$PKG"

[upstream]
url = "$URL"
branch = "$BRANCH"
type = "$TYPE"
registered = "$TIMESTAMP"

[tracking]
last_check = ""
last_version = ""
last_fetch = ""
status = "registered"
EOF

# 创建本地上游克隆目录
LOCAL_UPSTREAM="$UPSTREAM_DIR/repos/$PKG"
mkdir -p "$(dirname "$LOCAL_UPSTREAM")"

echo '{"status":"ok","pkg":"'"$PKG"'","upstream_file":"'"$UPSTREAM_FILE"'","url":"'"$URL"'","branch":"'"$BRANCH"'","type":"'"$TYPE"'","local_repo":"'"$LOCAL_UPSTREAM"'"}'

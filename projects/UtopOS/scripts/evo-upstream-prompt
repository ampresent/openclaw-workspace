#!/usr/bin/env bash
# evo-upstream-prompt — 交互式上游选择
# 用法: evo-upstream-prompt <pkg>
#
# 检测到多个上游来源时，提示用户选择：
#   - 社区上游 (community)
#   - 公司内部 fork (internal)
#   - 两者都跟踪
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
UPSTREAM_DIR="$EVO_HOME/upstream"
PKG="${1:?用法: evo-upstream-prompt <pkg>}"

# 已知上游源（常见包的默认上游）
declare -A KNOWN_UPSTREAMS=(
  ["nginx"]="https://github.com/nginx/nginx"
  ["openssh"]="https://github.com/openssh/openssh-portable"
  ["curl"]="https://github.com/curl/curl"
  ["redis"]="https://github.com/redis/redis"
  ["postgresql"]="https://github.com/postgres/postgres"
  ["node"]="https://github.com/nodejs/node"
  ["python3"]="https://github.com/python/cpython"
  ["gcc"]="https://github.com/gcc-mirror/gcc"
  ["glibc"]="https://github.com/bminor/glibc"
  ["linux"]="https://github.com/torvalds/linux"
)

# 检测可能的上游 URL
SUGGESTED_URLS=()

# 1. 检查已知上游
if [[ -n "${KNOWN_UPSTREAMS[$PKG]:-}" ]]; then
  SUGGESTED_URLS+=("community|${KNOWN_UPSTREAMS[$PKG]}|Known community upstream")
fi

# 2. 检查 nixpkgs 中的 source URL
if command -v nix &>/dev/null; then
  NIX_URL=$(nix eval -f '<nixpkgs>' "$PKG.src.meta.homepage" 2>/dev/null || echo "")
  if [[ -n "$NIX_URL" && "$NIX_URL" != *error* ]]; then
    SUGGESTED_URLS+=("community|${NIX_URL}|Nixpkgs homepage")
  fi
fi

# 3. 检查 RPM source URL
if command -v rpm &>/dev/null; then
  RPM_URL=$(rpm -qi "$PKG" 2>/dev/null | grep -i "^URL" | awk '{print $NF}' || echo "")
  if [[ -n "$RPM_URL" && "$RPM_URL" != "None" ]]; then
    SUGGESTED_URLS+=("community|${RPM_URL}|RPM package URL")
  fi
fi

# 4. 检查 GitLab/GitHub 上的内部 fork 模式
COMPANY="${EVO_COMPANY:-}"
if [[ -n "$COMPANY" ]]; then
  for host in "gitlab.${COMPANY}.com" "github.${COMPANY}.com" "git.${COMPANY}.com"; do
    INTERNAL_URL="https://${host}/${PKG}/${PKG}.git"
    SUGGESTED_URLS+=("internal|${INTERNAL_URL}|Internal fork at ${host}")
  done
fi

# 输出检测结果
echo '{"status":"ok","pkg":"'"$PKG"'","detected":'"${#SUGGESTED_URLS[@]}"'}' >&2

if [[ ${#SUGGESTED_URLS[@]} -eq 0 ]]; then
  echo '{"status":"prompt","pkg":"'"$PKG"'","message":"No upstream sources detected. Please provide manually.","options":[{"action":"manual","label":"Enter URL manually"}]}'
  exit 0
fi

# 构建选项 JSON
OPTIONS="["
for i in "${!SUGGESTED_URLS[@]}"; do
  IFS='|' read -r TYPE URL DESC <<< "${SUGGESTED_URLS[$i]}"
  [[ $i -gt 0 ]] && OPTIONS+=","
  OPTIONS+='{"index":'"$((i+1))"',"type":"'"$TYPE"'","url":"'"$URL"'","description":"'"$DESC"'"}'
done
# 添加手动选项
OPTIONS+=',{"index":'"$((${#SUGGESTED_URLS[@]}+1))"',"type":"manual","url":"","description":"Enter URL manually"}'
# 添加双跟踪选项
if [[ ${#SUGGESTED_URLS[@]} -ge 2 ]]; then
  OPTIONS+=',{"index":'"$((${#SUGGESTED_URLS[@]}+2))"',"type":"both","url":"","description":"Track both community and internal"}'
fi
OPTIONS+="]"

echo '{"status":"prompt","pkg":"'"$PKG"'","message":"Multiple upstream sources detected for '"$PKG"'. Choose one:","options":'"$OPTIONS"',"action_hint":"Run: evo-upstream-add <pkg> --url <url> --type <type>"}'

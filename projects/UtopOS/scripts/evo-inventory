#!/usr/bin/env bash
# evo-inventory — 机器清单管理
# 用法:
#   evo-inventory add <host> [--backend nix|rpm|conda] [--ip <addr>] [--ssh-user <user>]
#   evo-inventory remove <host>
#   evo-inventory list
#   evo-inventory update <host> --set-version <pkg>=<version>
#   evo-inventory sync-check
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
INVENTORY_FILE="$EVO_HOME/inventory.toml"
mkdir -p "$EVO_HOME"

ACTION="${1:?用法: evo-inventory <add|remove|list|update|sync-check> [host] [options]}"
shift

inventory_add() {
  local HOST="${1:?evo-inventory add <host>}"
  shift
  local BACKEND="unknown" IP="" SSH_USER="root"

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --backend)  BACKEND="$2"; shift 2 ;;
      --ip)       IP="$2"; shift 2 ;;
      --ssh-user) SSH_USER="$2"; shift 2 ;;
      *) shift ;;
    esac
  done

  # 检查是否已存在
  if [[ -f "$INVENTORY_FILE" ]] && grep -q "\[\[$HOST\]\]" "$INVENTORY_FILE" 2>/dev/null; then
    echo '{"status":"error","error":"host '"$HOST"' already in inventory"}'
    exit 1
  fi

  # 追加到 inventory 文件
  {
    echo ""
    echo "[[$HOST]]"
    echo "name = \"$HOST\""
    echo "backend = \"$BACKEND\""
    [[ -n "$IP" ]] && echo "ip = \"$IP\""
    echo "ssh_user = \"$SSH_USER\""
    echo "added = \"$(date -Iseconds)\""
  } >> "$INVENTORY_FILE"

  echo '{"status":"ok","action":"add","host":"'"$HOST"'","backend":"'"$BACKEND"'"}'
}

inventory_remove() {
  local HOST="${1:?evo-inventory remove <host>}"
  [[ -f "$INVENTORY_FILE" ]] || { echo '{"status":"error","error":"inventory file not found"}'; exit 1; }

  python3 -c "
found = False
lines = []
skip = False
with open('$INVENTORY_FILE') as f:
    for line in f:
        if line.strip() == '[[$HOST]]':
            skip = True
            found = True
            continue
        if skip and line.strip().startswith('[['):
            skip = False
        if not skip:
            lines.append(line)
with open('$INVENTORY_FILE', 'w') as f:
    f.writelines(lines)
print('{\"status\":\"ok\",\"action\":\"remove\",\"host\":\"$HOST\",\"found\":' + str(found).lower() + '}')
" 2>/dev/null
}

inventory_list() {
  [[ -f "$INVENTORY_FILE" ]] || { echo '{"status":"ok","action":"list","hosts":[]}'; exit 0; }

  python3 -c "
import json

hosts = []
current = {}
with open('$INVENTORY_FILE') as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#'):
            continue
        if line.startswith('[['):
            if current:
                hosts.append(current)
            current = {'name': line.strip('[]')}
        elif '=' in line:
            k, v = line.split('=', 1)
            current[k.strip()] = v.strip().strip('\"')
if current:
    hosts.append(current)

print(json.dumps({'status':'ok','action':'list','total':len(hosts),'hosts':hosts}))
" 2>/dev/null
}

inventory_update() {
  local HOST="${1:?evo-inventory update <host>}"
  shift
  [[ -f "$INVENTORY_FILE" ]] || { echo '{"status":"error","error":"inventory file not found"}'; exit 1; }

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --set-version)
        PKG_VER="$2"
        PKG_NAME="${PKG_VER%%=*}"
        PKG_VERSION="${PKG_VER#*=}"

        python3 -c "
lines = []
in_host = False
found_host = False
updated = False
with open('$INVENTORY_FILE') as f:
    for line in f:
        if line.strip() == '[[$HOST]]':
            in_host = True
            found_host = True
        elif line.strip().startswith('[['):
            in_host = False
        if in_host and line.startswith('version_$PKG_NAME'):
            lines.append('version_$PKG_NAME = \"$PKG_VERSION\"\n')
            updated = True
            continue
        lines.append(line)
if in_host and not updated:
    # 在该 host section 末尾添加
    for i in range(len(lines)-1, -1, -1):
        if lines[i].strip().startswith('[[') and '$HOST' in lines[i]:
            # 找到下一个 section 或文件末尾
            insert_at = i + 1
            while insert_at < len(lines) and not lines[insert_at].strip().startswith('[['):
                insert_at += 1
            lines.insert(insert_at, 'version_$PKG_NAME = \"$PKG_VERSION\"\n')
            break
with open('$INVENTORY_FILE', 'w') as f:
    f.writelines(lines)
print('{\"status\":\"ok\",\"action\":\"update\",\"host\":\"$HOST\",\"pkg\":\"$PKG_NAME\",\"version\":\"$PKG_VERSION\",\"found_host\":' + str(found_host).lower() + '}')
" 2>/dev/null
        shift 2
        ;;
      *) shift ;;
    esac
  done
}

inventory_sync_check() {
  [[ -f "$INVENTORY_FILE" ]] || { echo '{"status":"error","error":"inventory not configured"}'; exit 1; }

  echo -n '{"status":"ok","action":"sync-check","hosts":['
  FIRST=true
  python3 -c "
import json
hosts = []
current = {}
with open('$INVENTORY_FILE') as f:
    for line in f:
        line = line.strip()
        if not line or line.startswith('#'): continue
        if line.startswith('[['):
            if current: hosts.append(current)
            current = {'name': line.strip('[]')}
        elif '=' in line:
            k, v = line.split('=', 1)
            current[k.strip()] = v.strip().strip('\"')
if current: hosts.append(current)
print(json.dumps(hosts))
" 2>/dev/null | python3 -c "
import sys, json, subprocess
hosts = json.load(sys.stdin)
first = True
for h in hosts:
    name = h.get('name', 'unknown')
    ip = h.get('ip', name)
    user = h.get('ssh_user', 'root')
    backend = h.get('backend', 'unknown')

    # 尝试 ssh 连接检查
    reachable = False
    try:
        r = subprocess.run(['ssh', '-o', 'ConnectTimeout=5', '-o', 'StrictHostKeyChecking=no',
                           f'{user}@{ip}', 'echo ok'],
                          capture_output=True, text=True, timeout=10)
        reachable = r.returncode == 0
    except:
        pass

    status = 'reachable' if reachable else 'unreachable'
    comma = '' if first else ','
    first = False
    print(f'{comma}{{\"host\":\"{name}\",\"ip\":\"{ip}\",\"backend\":\"{backend}\",\"status\":\"{status}\"}}', end='')
" 2>/dev/null
  echo ']}'
}

case "$ACTION" in
  add)         inventory_add "$@" ;;
  remove)      inventory_remove "$@" ;;
  list)        inventory_list ;;
  update)      inventory_update "$@" ;;
  sync-check)  inventory_sync_check ;;
  *)           echo '{"status":"error","error":"unknown action: '"$ACTION"' (valid: add|remove|list|update|sync-check)"}'; exit 1 ;;
esac

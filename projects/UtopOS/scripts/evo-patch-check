#!/usr/bin/env bash
# evo-patch-check — 检查补丁兼容性
# 用法: evo-patch-check <pkg> [--against <version>]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
PKG="${1:?用法: evo-patch-check <pkg> [--against <version>]}"
shift
AGAINST=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --against) AGAINST="$2"; shift 2 ;;
    *) shift ;;
  esac
done

WORK_DIR="/tmp/evo-fix-${PKG}"
SRC_DIR="$WORK_DIR/src"
PATCHES_DIR="$EVO_HOME/patches/$PKG"

[[ -d "$SRC_DIR" ]] || { echo '{"status":"error","error":"source not found, run evo-fetch-source first"}'; exit 1; }
[[ -d "$PATCHES_DIR" ]] || { echo '{"status":"ok","pkg":"'"$PKG"'","results":[]}'; exit 0; }

echo -n '{"status":"ok","pkg":"'"$PKG"'","against_version":"'"${AGAINST:-current}"'","results":['
FIRST=true

for patch in "$PATCHES_DIR"/*.patch; do
  [[ -f "$patch" ]] || continue
  NAME=$(basename "$patch")

  # 尝试在源码上 apply（dry-run）
  APPLY_OUT=$(cd "$SRC_DIR" && git apply --check "$patch" 2>&1) && APPLY_OK=true || APPLY_OK=false

  if [[ "$APPLY_OK" == "true" ]]; then
    STATUS="compatible"
    CONFLICTS=""
  else
    STATUS="conflict"
    CONFLICTS=$(echo "$APPLY_OUT" | head -5 | tr '\n' ' ' | sed 's/"/\\"/g')
  fi

  [[ "$FIRST" == "true" ]] && FIRST=false || echo -n ','
  echo -n '{"patch":"'"$NAME"'","status":"'"$STATUS"'","conflicts":"'"$CONFLICTS"'"}'
done

echo ']}'

#!/usr/bin/env bash
# evo-sync — Patch 同步到其他机器
# 用法: evo-sync <pkg> --to <host1,host2,...> [--patch <file>] [--build-remote] [--user <ssh-user>]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
INVENTORY_FILE="$EVO_HOME/inventory.toml"
PKG="${1:?用法: evo-sync <pkg> --to <host1,host2,...> [--patch <file>] [--build-remote] [--user <ssh-user>]}"
shift

TARGETS="" PATCH_FILE="" BUILD_REMOTE=false SSH_USER="root"

while [[ $# -gt 0 ]]; do
  case "$1" in
    --to)            TARGETS="$2"; shift 2 ;;
    --patch)         PATCH_FILE="$2"; shift 2 ;;
    --build-remote)  BUILD_REMOTE=true; shift ;;
    --user)          SSH_USER="$2"; shift 2 ;;
    *) shift ;;
  esac
done

[[ -n "$TARGETS" ]] || { echo '{"status":"error","error":"--to is required"}'; exit 1; }

# 解析目标主机列表
IFS=',' read -ra HOSTS <<< "$TARGETS"

# 收集要同步的文件
SYNC_DIR="/tmp/evo-sync-${PKG}-$$"
mkdir -p "$SYNC_DIR"
trap 'rm -rf "$SYNC_DIR"' EXIT

# 复制 patch 文件
PATCHES_DIR="$EVO_HOME/patches/$PKG"
if [[ -d "$PATCHES_DIR" ]]; then
  cp -r "$PATCHES_DIR" "$SYNC_DIR/patches/"
fi

# 如果指定了单独的 patch
if [[ -n "$PATCH_FILE" && -f "$PATCH_FILE" ]]; then
  mkdir -p "$SYNC_DIR/extra-patches"
  cp "$PATCH_FILE" "$SYNC_DIR/extra-patches/"
fi

# 复制元数据
if [[ -f "$PATCHES_DIR/.last-rebase.json" ]]; then
  cp "$PATCHES_DIR/.last-rebase.json" "$SYNC_DIR/"
fi

# 创建同步信息文件
cat > "$SYNC_DIR/sync-info.json" <<EOF
{
  "pkg": "$PKG",
  "synced_at": "$(date -Iseconds)",
  "source": "$(hostname)",
  "patch_count": $(find "$SYNC_DIR/patches" -name '*.patch' 2>/dev/null | wc -l),
  "build_remote": $BUILD_REMOTE
}
EOF

echo '{"status":"syncing","pkg":"'"$PKG"'","hosts":'"$(printf '["%s",' "${HOSTS[@]}" | sed 's/,$//' | sed 's/$/]/')"',"sync_dir":"'"$SYNC_DIR"'"}' >&2

SYNCED=0 FAILED=0
RESULTS=""

for HOST in "${HOSTS[@]}"; do
  echo '{"status":"syncing","host":"'"$HOST"'"}' >&2

  REMOTE_EVO="/home/$SSH_USER/.evo"
  REMOTE_PATCHES="$REMOTE_EVO/patches/$PKG"

  # 同步 patch 文件到远程
  if rsync -az --mkpath \
    "$SYNC_DIR/" \
    "$SSH_USER@$HOST:$REMOTE_PATCHES/" 2>/dev/null; then

    # 如果需要远程构建
    if [[ "$BUILD_REMOTE" == "true" ]]; then
      ssh "$SSH_USER@$HOST" "EVO_HOME=$REMOTE_EVO $REMOTE_EVO/scripts/evo-build $PKG" 2>/dev/null && {
        RESULTS="${RESULTS}{\"host\":\"$HOST\",\"status\":\"synced+built\"},"
      } || {
        RESULTS="${RESULTS}{\"host\":\"$HOST\",\"status\":\"synced+build-failed\"},"
      }
    else
      RESULTS="${RESULTS}{\"host\":\"$HOST\",\"status\":\"synced\"},"
    fi
    SYNCED=$((SYNCED + 1))
  else
    RESULTS="${RESULTS}{\"host\":\"$HOST\",\"status\":\"failed\"},"
    FAILED=$((FAILED + 1))
  fi
done

RESULTS="${RESULTS%,}"

echo '{"status":"ok","pkg":"'"$PKG"'","synced":'"$SYNCED"',"failed":'"$FAILED"',"results":['"$RESULTS"']}'

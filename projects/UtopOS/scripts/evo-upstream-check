#!/usr/bin/env bash
# evo-upstream-check — 检查上游更新
# 用法: evo-upstream-check <pkg> [--all]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
UPSTREAM_DIR="$EVO_HOME/upstream"

check_single() {
  local PKG="$1"
  local UPSTREAM_FILE="$UPSTREAM_DIR/${PKG}.toml"
  [[ -f "$UPSTREAM_FILE" ]] || { echo '{"status":"error","pkg":"'"$PKG"'","error":"upstream not registered, run evo-upstream-add first"}'; return 1; }

  # 解析 toml 配置
  local URL BRANCH LAST_VERSION
  URL=$(grep '^url ' "$UPSTREAM_FILE" | sed 's/url = "\(.*\)"/\1/')
  BRANCH=$(grep '^branch ' "$UPSTREAM_FILE" | sed 's/branch = "\(.*\)"/\1/')
  LAST_VERSION=$(grep '^last_version ' "$UPSTREAM_FILE" | sed 's/last_version = "\(.*\)"/\1/' || echo "")

  [[ -n "$URL" ]] || { echo '{"status":"error","pkg":"'"$PKG"'","error":"no upstream URL configured"}'; return 1; }

  local LOCAL_UPSTREAM="$UPSTREAM_DIR/repos/$PKG"
  local REMOTE_HEAD=""

  if [[ -d "$LOCAL_UPSTREAM/.git" ]]; then
    # 已有本地克隆，fetch 后比较
    cd "$LOCAL_UPSTREAM"
    git fetch origin "$BRANCH" --quiet 2>/dev/null || true
    REMOTE_HEAD=$(git rev-parse "origin/$BRANCH" 2>/dev/null || echo "unknown")
    LOCAL_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "unknown")

    local BEHIND=0
    if [[ "$REMOTE_HEAD" != "unknown" && "$LOCAL_HEAD" != "unknown" ]]; then
      BEHIND=$(git rev-list HEAD.."origin/$BRANCH" --count 2>/dev/null || echo 0)
    fi

    # 获取变更摘要
    local CHANGE_SUMMARY=""
    if [[ $BEHIND -gt 0 ]]; then
      CHANGE_SUMMARY=$(git log HEAD.."origin/$BRANCH" --oneline 2>/dev/null | head -10 | tr '\n' ';' || echo "")
    fi

    local HAS_UPDATE="false"
    [[ $BEHIND -gt 0 ]] && HAS_UPDATE="true"

    echo '{"status":"ok","pkg":"'"$PKG"'","has_update":'"$HAS_UPDATE"',"commits_behind":'"$BEHIND"',"local_head":"'"$LOCAL_HEAD"'","remote_head":"'"$REMOTE_HEAD"'","change_summary":"'"$CHANGE_SUMMARY"'"}'
  else
    # 没有本地克隆，用 ls-remote 检查
    REMOTE_HEAD=$(git ls-remote "$URL" "refs/heads/$BRANCH" 2>/dev/null | awk '{print $1}' || echo "unknown")
    local HAS_UPDATE="false"
    if [[ -n "$LAST_VERSION" && "$REMOTE_HEAD" != "unknown" && "$REMOTE_HEAD" != "$LAST_VERSION" ]]; then
      HAS_UPDATE="true"
    fi

    echo '{"status":"ok","pkg":"'"$PKG"'","has_update":'"$HAS_UPDATE"',"remote_head":"'"$REMOTE_HEAD"'","last_known":"'"$LAST_VERSION"'"}'
  fi

  # 更新 check 时间
  python3 -c "
lines = []
with open('$UPSTREAM_FILE') as f:
    for line in f:
        if line.startswith('last_check'):
            lines.append('last_check = \"' + '$(date -Iseconds)' + '\"\n')
        elif line.startswith('last_version') and '$REMOTE_HEAD' != 'unknown':
            lines.append('last_version = \"$REMOTE_HEAD\"\n')
        else:
            lines.append(line)
with open('$UPSTREAM_FILE', 'w') as f:
    f.writelines(lines)
" 2>/dev/null || true
}

if [[ "${1:-}" == "--all" ]]; then
  echo -n '{"status":"ok","action":"check-all","results":['
  FIRST=true
  for f in "$UPSTREAM_DIR"/*.toml; do
    [[ -f "$f" ]] || continue
    PKG_NAME=$(basename "$f" .toml)
    [[ "$FIRST" == "true" ]] && FIRST=false || echo -n ','
    check_single "$PKG_NAME" 2>/dev/null || echo '{"status":"error","pkg":"'"$PKG_NAME"'"}'
  done
  echo ']}'
else
  PKG="${1:?用法: evo-upstream-check <pkg> [--all]}"
  check_single "$PKG"
fi

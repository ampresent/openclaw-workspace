# nix-evo hosts configuration
# Copy to ~/.config/nix-evo/hosts.toml

[hosts.default]
# Agent API endpoint
url = "http://127.0.0.1:7890"

# Optional API token
# token = "your-secret-token"

# For remote hosts, use SSH tunnel:
# ssh -L 7890:127.0.0.1:7890 user@remote-host
# Then set url to http://127.0.0.1:7890

[hosts.production]
url = "http://127.0.0.1:7890"
# token = "prod-token"

[hosts.staging]
url = "http://127.0.0.1:7891"

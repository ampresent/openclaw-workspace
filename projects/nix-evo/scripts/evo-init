#!/usr/bin/env bash
# evo-init — 初始化 nix-evo 工作目录结构
# 用法: evo-init [--force]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
FORCE=false
[[ "${1:-}" == "--force" ]] && FORCE=true

json_ok() { echo '{"status":"ok","action":"init","home":"'"$EVO_HOME"'","dirs":['"$@"']}'; }
json_err() { echo '{"status":"error","action":"init","error":"'"$1"'"}'; exit 1; }

if [[ -d "$EVO_HOME" && "$FORCE" == "false" ]]; then
  json_ok '"already_exists"'
  exit 0
fi

DIRS=(patches builds cache logs archive work upstream history)
CREATED=()
for d in "${DIRS[@]}"; do
  mkdir -p "$EVO_HOME/$d"
  CREATED+=("\"$d\"")
done

# 生成默认配置
CONFIG="$EVO_HOME/config"
if [[ ! -f "$CONFIG" || "$FORCE" == "true" ]]; then
  cat > "$CONFIG" <<'EOF'
# nix-evo config — auto-generated by evo-init
# backend: auto-detect | nix | rpm | conda
backend=auto-detect
# patch_policy: ask | safe-auto | all-auto
patch_policy=ask
# max_parallel_builds
max_parallel_builds=2
# cache_ttl_days (源码缓存保留天数)
cache_ttl_days=30
# builds_ttl_days (构建产物保留天数)
builds_ttl_days=14
EOF
fi

# 生成 trust.toml 模板
TRUST="$EVO_HOME/trust.toml"
if [[ ! -f "$TRUST" || "$FORCE" == "true" ]]; then
  cat > "$TRUST" <<'EOF'
# nix-evo trust — 白名单: 指定包的 safe 级 patch 自动 apply
# [trust.nginx]
# safe_auto = true
# risk_levels = ["safe"]
EOF
fi

# 生成 inventory.toml 模板
INV="$EVO_HOME/inventory.toml"
if [[ ! -f "$INV" || "$FORCE" == "true" ]]; then
  cat > "$INV" <<'EOF'
# nix-evo inventory — 多机管理
# [hosts.server1]
# addr = "192.168.1.10"
# user = "root"
# backend = "nix"
EOF
fi

DIR_LIST=$(IFS=,; echo "${CREATED[*]}")
json_ok "$DIR_LIST"

#!/usr/bin/env bash
# evo-cleanup — 清理临时文件、缓存、构建产物
# 用法: evo-cleanup [--work-days N] [--cache-days N] [--builds-days N] [--dry-run]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"

# 默认保留天数（从 config 读取，覆盖为命令行参数）
WORK_DAYS=7
CACHE_DAYS=30
BUILDS_DAYS=14
DRY_RUN=false

# 从 config 读取默认值
if [[ -f "$EVO_HOME/config" ]]; then
  CACHE_DAYS=$(grep '^cache_ttl_days' "$EVO_HOME/config" 2>/dev/null | cut -d= -f2 || echo 30)
  BUILDS_DAYS=$(grep '^builds_ttl_days' "$EVO_HOME/config" 2>/dev/null | cut -d= -f2 || echo 14)
fi

while [[ $# -gt 0 ]]; do
  case "$1" in
    --work-days)   WORK_DAYS="$2"; shift 2 ;;
    --cache-days)  CACHE_DAYS="$2"; shift 2 ;;
    --builds-days) BUILDS_DAYS="$2"; shift 2 ;;
    --dry-run)     DRY_RUN=true; shift ;;
    *) shift ;;
  esac
done

cleaned_work=0 cleaned_cache=0 cleaned_builds=0 freed_bytes=0

# 清理 /tmp/evo-fix-* (超过 WORK_DAYS 天)
for dir in /tmp/evo-fix-*; do
  [[ -d "$dir" ]] || continue
  # 跳过标记为 keep 的
  [[ -f "$dir/.evo-keep" ]] && continue
  # 检查修改时间
  if [[ $(find "$dir" -maxdepth 0 -mtime +"$WORK_DAYS" 2>/dev/null) ]]; then
    if [[ "$DRY_RUN" == "true" ]]; then
      echo "[dry-run] would remove: $dir" >&2
    else
      SIZE=$(du -sb "$dir" 2>/dev/null | awk '{print $1}')
      rm -rf "$dir"
      freed_bytes=$((freed_bytes + ${SIZE:-0}))
    fi
    cleaned_work=$((cleaned_work + 1))
  fi
done

# 清理 ~/.evo/cache/ (超过 CACHE_DAYS 天)
if [[ -d "$EVO_HOME/cache" ]]; then
  while IFS= read -r -d '' item; do
    if [[ "$DRY_RUN" == "true" ]]; then
      echo "[dry-run] would remove cache: $item" >&2
    else
      SIZE=$(du -sb "$item" 2>/dev/null | awk '{print $1}')
      rm -rf "$item"
      freed_bytes=$((freed_bytes + ${SIZE:-0}))
    fi
    cleaned_cache=$((cleaned_cache + 1))
  done < <(find "$EVO_HOME/cache" -mindepth 1 -maxdepth 1 -mtime +"$CACHE_DAYS" -print0 2>/dev/null)
fi

# 清理 ~/.evo/builds/ (超过 BUILDS_DAYS 天)
if [[ -d "$EVO_HOME/builds" ]]; then
  while IFS= read -r -d '' item; do
    if [[ "$DRY_RUN" == "true" ]]; then
      echo "[dry-run] would remove build: $item" >&2
    else
      SIZE=$(du -sb "$item" 2>/dev/null | awk '{print $1}')
      rm -rf "$item"
      freed_bytes=$((freed_bytes + ${SIZE:-0}))
    fi
    cleaned_builds=$((cleaned_builds + 1))
  done < <(find "$EVO_HOME/builds" -mindepth 1 -maxdepth 1 -mtime +"$BUILDS_DAYS" -print0 2>/dev/null)
fi

# 磁盘水位检查
DISK_USAGE=$(df -h "$EVO_HOME" 2>/dev/null | tail -1 | awk '{print $5}' | tr -d '%')
DISK_WARN="false"
if [[ "$DISK_USAGE" -gt 90 ]]; then
  DISK_WARN="true"
  echo "[warning] disk usage at ${DISK_USAGE}% — consider aggressive cleanup" >&2
fi

FREED_HUMAN=$(numfmt --to=iec "$freed_bytes" 2>/dev/null || echo "${freed_bytes}B")
echo '{"status":"ok","action":"cleanup","dry_run":'"$DRY_RUN"',"cleaned":{"workspaces":'"$cleaned_work"',"cache":'"$cleaned_cache"',"builds":'"$cleaned_builds"'},"freed_bytes":'"$freed_bytes"',"freed_human":"'"$FREED_HUMAN"'","disk_usage_pct":'"$DISK_USAGE"',"disk_warning":'"$DISK_WARN"'}'

#!/usr/bin/env bash
# evo-patch-series — 管理补丁应用顺序
# 用法:
#   evo-patch-series show <pkg>                    — 显示当前 series
#   evo-patch-series add <pkg> <patch> [--after X] — 添加到 series
#   evo-patch-series remove <pkg> <patch>          — 从 series 移除
#   evo-patch-series reorder <pkg>                 — 交互式重排
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
ACTION="${1:?用法: evo-patch-series <show|add|remove|reorder> <pkg> [patch]}"
shift

get_series_file() { echo "$EVO_HOME/patches/$1/series"; }

case "$ACTION" in
  show)
    PKG="${1:?evo-patch-series show <pkg>}"
    SERIES_FILE=$(get_series_file "$PKG")
    if [[ ! -f "$SERIES_FILE" ]]; then
      echo '{"status":"ok","pkg":"'"$PKG"'","series":[]}'
      exit 0
    fi
    echo -n '{"status":"ok","pkg":"'"$PKG"'","series":['
    FIRST=true
    while IFS= read -r line; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      [[ "$FIRST" == "true" ]] && FIRST=false || echo -n ','
      echo -n '"'"$line"'"'
    done < "$SERIES_FILE"
    echo ']}'
    ;;

  add)
    PKG="${1:?evo-patch-series add <pkg> <patch> [--after X]}"
    PATCH="${2:?patch name required}"
    shift 2 || true
    AFTER=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --after) AFTER="$2"; shift 2 ;;
        *) shift ;;
      esac
    done
    SERIES_FILE=$(get_series_file "$PKG")
    mkdir -p "$(dirname "$SERIES_FILE")"
    if [[ ! -f "$SERIES_FILE" ]]; then
      echo "# nix-evo patch series for $PKG" > "$SERIES_FILE"
    fi
    if [[ -n "$AFTER" ]]; then
      sed -i "/^${AFTER}$/a ${PATCH}" "$SERIES_FILE"
    else
      echo "$PATCH" >> "$SERIES_FILE"
    fi
    echo '{"status":"ok","action":"add","pkg":"'"$PKG"'","patch":"'"$PATCH"'","after":"'"${AFTER:-none}"'"}'
    ;;

  remove)
    PKG="${1:?evo-patch-series remove <pkg> <patch>}"
    PATCH="${2:?patch name required}"
    SERIES_FILE=$(get_series_file "$PKG")
    if [[ -f "$SERIES_FILE" ]]; then
      sed -i "/^${PATCH}$/d" "$SERIES_FILE"
    fi
    echo '{"status":"ok","action":"remove","pkg":"'"$PKG"'","patch":"'"$PATCH"'"}'
    ;;

  reorder)
    PKG="${1:?evo-patch-series reorder <pkg>}"
    SERIES_FILE=$(get_series_file "$PKG")
    [[ -f "$SERIES_FILE" ]] || { echo '{"status":"error","error":"no series file found"}'; exit 1; }
    # 输出当前顺序供 agent/user 决定
    echo '{"status":"needs_input","action":"reorder","pkg":"'"$PKG"'","current_order":'"$(cat "$SERIES_FILE" | grep -v '^#' | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")"',"hint":"edit '"$SERIES_FILE"' to reorder, then commit"}'
    ;;

  *)
    echo '{"status":"error","error":"unknown action: '"$ACTION"' (valid: show|add|remove|reorder)"}'; exit 1 ;;
esac

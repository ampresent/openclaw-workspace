#!/usr/bin/env bash
# evo-build — 统一构建入口
# 用法: evo-build <pkg> [--backend nix|rpm|conda] [--patch <patch-file>]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
PKG="${1:?用法: evo-build <pkg> [--backend nix|rpm|conda] [--patch <patch-file>]}"
shift
BACKEND=""
PATCH_FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend) BACKEND="$2"; shift 2 ;;
    --patch)   PATCH_FILE="$2"; shift 2 ;;
    *) shift ;;
  esac
done

if [[ -z "$BACKEND" ]]; then
  BACKEND=$("$EVO_HOME"/scripts/evo-detect 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['backend'])" 2>/dev/null || echo "unknown")
fi

WORK_DIR="/tmp/evo-fix-${PKG}"
LOG_DIR="$EVO_HOME/logs"
BUILDS_DIR="$EVO_HOME/builds/${PKG}"
mkdir -p "$LOG_DIR" "$BUILDS_DIR"

TIMESTAMP=$(date +%Y%m%d-%H%M%S)
LOG_FILE="$LOG_DIR/${PKG}-${TIMESTAMP}.log"

build_nix() {
  local src="$WORK_DIR/src"
  [[ -d "$src" ]] || { echo '{"status":"error","error":"source not found at '"$src"', run evo-fetch-source first"}'; exit 1; }

  # 创建 overlay
  local overlay_dir="$WORK_DIR/overlay"
  mkdir -p "$overlay_dir"
  cat > "$overlay_dir/default.nix" <<NLIX
final: prev: {
  $PKG = prev.$PKG.overrideAttrs (old: {
    patches = (old.patches or []) ++ [
NLIX
  if [[ -n "$PATCH_FILE" ]]; then
    echo "      $(realpath "$PATCH_FILE")" >> "$overlay_dir/default.nix"
  fi
  cat >> "$overlay_dir/default.nix" <<NLIX
    ];
  });
}
NLIX

  echo '{"status":"building","backend":"nix","pkg":"'"$PKG"'","overlay":"'"$overlay_dir/default.nix"'"}' >&2

  # 构建（用 overlay）
  if nix-build -E "with import <nixpkgs> { overlays = [ (import $overlay_dir/default.nix) ]; }; $PKG" 2>&1 | tee "$LOG_FILE"; then
    local result
    result=$(readlink -f result 2>/dev/null || echo "N/A")
    date -Iseconds > "$WORK_DIR/.last-build"
    cp "$overlay_dir/default.nix" "$BUILDS_DIR/overlay-${TIMESTAMP}.nix" 2>/dev/null || true
    echo '{"status":"ok","backend":"nix","pkg":"'"$PKG"'","result":"'"$result"'","log":"'"$LOG_FILE"'","overlay":"'"$overlay_dir/default.nix"'"}'
  else
    echo '{"status":"error","backend":"nix","pkg":"'"$PKG"'","error":"build failed","log":"'"$LOG_FILE"'"}'
    exit 1
  fi
}

build_rpm() {
  local spec=""
  # 找 spec 文件
  spec=$(find ~/rpmbuild/SPECS/ -name "*.spec" 2>/dev/null | head -1)
  [[ -n "$spec" ]] || { echo '{"status":"error","error":"no spec file found in ~/rpmbuild/SPECS/"}'; exit 1; }

  # 应用 patch 到 SOURCES
  if [[ -n "$PATCH_FILE" ]]; then
    local patch_name
    patch_name=$(basename "$PATCH_FILE")
    cp "$PATCH_FILE" ~/rpmbuild/SOURCES/"$patch_name"
    # 在 spec 中注册 patch（如果还没注册）
    if ! grep -q "$patch_name" "$spec"; then
      echo "Patch99: $patch_name" >> "$spec"
      # 在 %prep 的 %setup 后添加 patch 应用
      sed -i '/^%setup/a %patch99 -p1' "$spec" 2>/dev/null || true
    fi
  fi

  echo '{"status":"building","backend":"rpm","pkg":"'"$PKG"'","spec":"'"$spec"'"}' >&2

  if rpmbuild -ba "$spec" 2>&1 | tee "$LOG_FILE"; then
    local rpm_file
    rpm_file=$(find ~/rpmbuild/RPMS/ -name "${PKG}*.rpm" 2>/dev/null | head -1 || echo "N/A")
    # 复制到 builds 目录
    cp "$rpm_file" "$BUILDS_DIR/" 2>/dev/null || true
    date -Iseconds > "$WORK_DIR/.last-build"
    echo '{"status":"ok","backend":"rpm","pkg":"'"$PKG"'","rpm":"'"$rpm_file"'","log":"'"$LOG_FILE"'","builds_dir":"'"$BUILDS_DIR"'"}'
  else
    echo '{"status":"error","backend":"rpm","pkg":"'"$PKG"'","error":"rpmbuild failed","log":"'"$LOG_FILE"'"}'
    exit 1
  fi
}

build_conda() {
  local recipe=""
  # 找 recipe
  for candidate in "$WORK_DIR/src/recipe" "$WORK_DIR/src/$PKG"; do
    [[ -d "$candidate" ]] && recipe="$candidate" && break
  done
  [[ -n "$recipe" ]] || { echo '{"status":"error","error":"no conda recipe found in workdir"}'; exit 1; }

  # 应用 patch 到 recipe
  if [[ -n "$PATCH_FILE" ]]; then
    cp "$PATCH_FILE" "$recipe/"
    local patch_name
    patch_name=$(basename "$PATCH_FILE")
    # 更新 meta.yaml 的 patches 列表
    if [[ -f "$recipe/meta.yaml" ]] && ! grep -q "$patch_name" "$recipe/meta.yaml"; then
      if grep -q "patches:" "$recipe/meta.yaml"; then
        sed -i "/patches:/a\\    - $patch_name" "$recipe/meta.yaml"
      else
        sed -i "/source:/a\\  patches:\\n    - $patch_name" "$recipe/meta.yaml"
      fi
    fi
  fi

  echo '{"status":"building","backend":"conda","pkg":"'"$PKG"'","recipe":"'"$recipe"'"}' >&2

  if conda build "$recipe" 2>&1 | tee "$LOG_FILE"; then
    local pkg_path
    pkg_path=$(conda build "$recipe" --output 2>/dev/null || echo "N/A")
    cp "$pkg_path" "$BUILDS_DIR/" 2>/dev/null || true
    date -Iseconds > "$WORK_DIR/.last-build"
    echo '{"status":"ok","backend":"conda","pkg":"'"$PKG"'","conda_pkg":"'"$pkg_path"'","log":"'"$LOG_FILE"'","builds_dir":"'"$BUILDS_DIR"'"}'
  else
    echo '{"status":"error","backend":"conda","pkg":"'"$PKG"'","error":"conda build failed","log":"'"$LOG_FILE"'"}'
    exit 1
  fi
}

case "$BACKEND" in
  nix)   build_nix ;;
  rpm)   build_rpm ;;
  conda) build_conda ;;
  *)     echo '{"status":"error","error":"unknown backend: '"$BACKEND"'"}'; exit 1 ;;
esac

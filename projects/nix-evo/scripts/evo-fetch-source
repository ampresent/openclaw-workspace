#!/usr/bin/env bash
# evo-fetch-source — 下载指定包的源码
# 用法: evo-fetch-source <pkg> [--backend nix|rpm|conda] [--force]
# 输出: JSON { status, backend, pkg, src_dir, spec?, recipe? }
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
PKG="${1:?用法: evo-fetch-source <pkg> [--backend nix|rpm|conda] [--force]}"
shift
BACKEND=""
FORCE=false

while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend) BACKEND="$2"; shift 2 ;;
    --force)   FORCE=true; shift ;;
    *) shift ;;
  esac
done

# 自动检测后端
if [[ -z "$BACKEND" ]]; then
  BACKEND=$("$EVO_HOME"/scripts/evo-detect 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['backend'])" 2>/dev/null || echo "unknown")
fi

CACHE_DIR="$EVO_HOME/cache/${PKG}"
WORK_DIR="/tmp/evo-fix-${PKG}"

# 缓存命中检查
if [[ -d "$CACHE_DIR" && "$FORCE" == "false" ]]; then
  SRC_DIR=$(find "$CACHE_DIR" -maxdepth 1 -type d -name '*-*' | head -1)
  if [[ -n "$SRC_DIR" ]]; then
    echo '{"status":"cached","backend":"'"$BACKEND"'","pkg":"'"$PKG"'","src_dir":"'"$SRC_DIR"'","work_dir":"'"$WORK_DIR"'"}'
    exit 0
  fi
fi

mkdir -p "$CACHE_DIR" "$WORK_DIR"

case "$BACKEND" in
  nix)
    echo '{"status":"fetching","backend":"nix","pkg":"'"$PKG"'","step":"nix-build src"}' >&2
    # 获取源码 derivation
    SRC=$(nix-build '<nixpkgs>' -A "$PKG.src" --no-out-link 2>/dev/null) || {
      echo '{"status":"error","backend":"nix","pkg":"'"$PKG"'","error":"failed to fetch src via nix-build"}'
      exit 1
    }
    # 复制到缓存
    cp -r "$SRC" "$CACHE_DIR/src"
    cp -r "$SRC" "$WORK_DIR/src"
    # 获取包版本
    VER=$(nix-instantiate --eval -E '(import <nixpkgs> {}).'$PKG'.version' 2>/dev/null | tr -d '"' || echo "unknown")
    echo '{"status":"ok","backend":"nix","pkg":"'"$PKG"'","version":"'"$VER"'","src_dir":"'"$WORK_DIR/src"'","cache_dir":"'"$CACHE_DIR/src"'","meta":{"derivation":"'"$SRC"'","work_dir":"'"$WORK_DIR"'"}}'
    ;;

  rpm)
    echo '{"status":"fetching","backend":"rpm","pkg":"'"$PKG"'","step":"download SRPM"}' >&2
    cd "$WORK_DIR"
    # 下载 SRPM
    if command -v dnf &>/dev/null; then
      dnf download --source "$PKG" 2>/dev/null || {
        echo '{"status":"error","backend":"rpm","pkg":"'"$PKG"'","error":"dnf download --source failed"}'
        exit 1
      }
    elif command -v yumdownloader &>/dev/null; then
      yumdownloader --source "$PKG" 2>/dev/null || {
        echo '{"status":"error","backend":"rpm","pkg":"'"$PKG"'","error":"yumdownloader --source failed"}'
        exit 1
      }
    fi
    # 安装 SRPM
    SRPM=$(ls "$WORKDIR"/*.src.rpm 2>/dev/null | head -1)
    if [[ -z "$SRPM" ]]; then
      echo '{"status":"error","backend":"rpm","pkg":"'"$PKG"'","error":"no .src.rpm found in workdir"}'
      exit 1
    fi
    rpm -ivh "$SRPM" 2>/dev/null || true
    SPEC_FILE=$(ls ~/rpmbuild/SPECS/*.spec 2>/dev/null | head -1 || echo "")
    # 解压源码
    mkdir -p "$WORK_DIR/src"
    for tarball in ~/rpmbuild/SOURCES/*.tar.gz ~/rpmbuild/SOURCES/*.tar.xz ~/rpmbuild/SOURCES/*.tar.bz2; do
      [[ -f "$tarball" ]] || continue
      tar xf "$tarball" -C "$WORK_DIR/src" 2>/dev/null && break
    done
    # 缓存
    cp -r "$WORK_DIR/src" "$CACHE_DIR/src" 2>/dev/null || true
    cp -r ~/rpmbuild/SPECS "$CACHE_DIR/" 2>/dev/null || true
    VER=$(rpm -qp --queryformat '%{VERSION}' "$SRPM" 2>/dev/null || echo "unknown")
    echo '{"status":"ok","backend":"rpm","pkg":"'"$PKG"'","version":"'"$VER"'","src_dir":"'"$WORK_DIR/src"'","spec":"'"$SPEC_FILE"'","rpmbuild":"~/rpmbuild","cache_dir":"'"$CACHE_DIR"'"}'
    ;;

  conda)
    echo '{"status":"fetching","backend":"conda","pkg":"'"$PKG"'","step":"clone feedstock"}' >&2
    # 尝试 conda-forge feedstock
    if git clone "https://github.com/conda-forge/${PKG}-feedstock.git" "$WORK_DIR/src" 2>/dev/null; then
      RECIPE="$WORK_DIR/src/recipe"
    elif command -v conda &>/dev/null; then
      mkdir -p "$WORK_DIR/src"
      conda skeleton pypi "$PKG" --output-dir "$WORK_DIR/src" 2>/dev/null || {
        echo '{"status":"error","backend":"conda","pkg":"'"$PKG"'","error":"both feedstock clone and conda skeleton failed"}'
        exit 1
      }
      RECIPE="$WORK_DIR/src/$PKG"
    else
      echo '{"status":"error","backend":"conda","pkg":"'"$PKG"'","error":"git clone failed and conda not available"}'
      exit 1
    fi
    cp -r "$WORK_DIR/src" "$CACHE_DIR/src" 2>/dev/null || true
    echo '{"status":"ok","backend":"conda","pkg":"'"$PKG"'","src_dir":"'"$WORK_DIR/src"'","recipe":"'"$RECIPE"'","cache_dir":"'"$CACHE_DIR/src"'"}'
    ;;

  *)
    echo '{"status":"error","backend":"'"$BACKEND"'","pkg":"'"$PKG"'","error":"unsupported backend, use --backend nix|rpm|conda"}'
    exit 1
    ;;
esac

#!/usr/bin/env bash
# evo-verify — 安装前验证（dry-run）
# 用法: evo-verify <pkg> [--backend nix|rpm|conda]
set -euo pipefail

EVO_HOME="${EVO_HOME:-$HOME/.evo}"
PKG="${1:?用法: evo-verify <pkg> [--backend nix|rpm|conda]}"
shift
BACKEND=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --backend) BACKEND="$2"; shift 2 ;;
    *) shift ;;
  esac
done

if [[ -z "$BACKEND" ]]; then
  BACKEND=$("$EVO_HOME"/scripts/evo-detect 2>/dev/null | python3 -c "import sys,json; print(json.load(sys.stdin)['backend'])" 2>/dev/null || echo "unknown")
fi

RISK="unknown"
VERIFY_CMD=""
VERIFY_OUT=""

case "$BACKEND" in
  nix)
    # dry-build: 构建但不激活
    VERIFY_CMD="nixos-rebuild dry-build"
    VERIFY_OUT=$(nixos-rebuild dry-build 2>&1) && RISK="safe" || RISK="dangerous"
    # 提取变更摘要
    CHANGES=$(echo "$VERIFY_OUT" | grep -E "(will be|→|changed)" | head -20 || echo "no changes detected")
    echo '{"status":"ok","backend":"nix","pkg":"'"$PKG"'","risk":"'"$RISK"'","verify_cmd":"'"$VERIFY_CMD"'","changes":"'"$(echo "$CHANGES" | tr '\n' ' ' | sed 's/"/\\"/g')"'","full_log":"'"$(echo "$VERIFY_OUT" | tail -30 | tr '\n' ' ' | sed 's/"/\\"/g')"'"}'
    ;;

  rpm)
    # 检查已构建的 RPM
    RPM_FILE=$(find "$EVO_HOME/builds/${PKG}/" -name "*.rpm" 2>/dev/null | head -1)
    if [[ -z "$RPM_FILE" ]]; then
      echo '{"status":"error","backend":"rpm","pkg":"'"$PKG"'","error":"no built RPM found, run evo-build first"}'
      exit 1
    fi
    # 检查依赖
    VERIFY_OUT=$(rpm -qpR "$RPM_FILE" 2>&1)
    MISSING=()
    while read -r dep; do
      [[ -z "$dep" ]] && continue
      if ! rpm -q --whatprovides "$dep" &>/dev/null; then
        MISSING+=("$dep")
      fi
    done <<< "$VERIFY_OUT"
    if [[ ${#MISSING[@]} -eq 0 ]]; then
      RISK="safe"
    elif [[ ${#MISSING[@]} -le 3 ]]; then
      RISK="moderate"
    else
      RISK="dangerous"
    fi
    # 测试安装（不执行）
    VERIFY_TEST=$(rpm -Uvh --test "$RPM_FILE" 2>&1) && TEST_OK=true || TEST_OK=false
    echo '{"status":"ok","backend":"rpm","pkg":"'"$PKG"'","risk":"'"$RISK"'","rpm":"'"$RPM_FILE"'","missing_deps":'"$(printf '%s\n' "${MISSING[@]}" | python3 -c "import sys,json; print(json.dumps([l.strip() for l in sys.stdin if l.strip()]))")',"test_install_ok":'"$TEST_OK"',"test_output":"'"$(echo "$VERIFY_TEST" | tr '\n' ' ' | sed 's/"/\\"/g')"'"}'
    ;;

  conda)
    # 检查已构建的包
    PKG_PATH=$(conda build "$PKG" --output 2>/dev/null || echo "")
    if [[ -z "$PKG_PATH" ]]; then
      echo '{"status":"error","backend":"conda","pkg":"'"$PKG"'","error":"no built conda pkg found, run evo-build first"}'
      exit 1
    fi
    # 检查依赖是否满足
    VERIFY_OUT=$(conda install --dry-run --use-local "$PKG" 2>&1) && RISK="safe" || RISK="moderate"
    CHANGES=$(echo "$VERIFY_OUT" | grep -E "^(  -|  \+)" | head -20 || echo "")
    echo '{"status":"ok","backend":"conda","pkg":"'"$PKG"'","risk":"'"$RISK"'","pkg_path":"'"$PKG_PATH"'","changes":"'"$(echo "$CHANGES" | tr '\n' ' ' | sed 's/"/\\"/g')"'","dry_run_output":"'"$(echo "$VERIFY_OUT" | tail -10 | tr '\n' ' ' | sed 's/"/\\"/g')"'"}'
    ;;

  *)
    echo '{"status":"error","error":"unknown backend: '"$BACKEND"'"}'; exit 1 ;;
esac

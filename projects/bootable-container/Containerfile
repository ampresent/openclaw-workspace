# Bootc 自定义镜像
# 基于 Fedora bootc（registry.fedoraproject.org 国内可访问）

FROM registry.fedoraproject.org/fedora-bootc:41

# 安装软件包
RUN dnf install -y vim curl openssh-server sudo && dnf clean all

# 启用 SSH 密码登录 — 通过 drop-in 配置
RUN mkdir -p /etc/ssh/sshd_config.d && \
    printf "PasswordAuthentication yes\nPermitRootLogin yes\n" > /etc/ssh/sshd_config.d/02-password-auth.conf

# 生成 SSH host keys
RUN ssh-keygen -A

# 注入 SSH 公钥
RUN mkdir -p /root/.ssh && chmod 700 /root/.ssh
COPY bootc-key.pub /root/.ssh/authorized_keys
RUN chmod 600 /root/.ssh/authorized_keys

# 启用 sshd
RUN systemctl enable sshd

# 设置 root 密码（备用）
RUN echo 'root:Bebop4life&' | chpasswd
